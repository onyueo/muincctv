<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="titleText"
            type="java.lang.String" />
        <variable
            name="recordingList"
            type="java.util.List" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".RecordingListActivity">

        <include
            android:id="@+id/add_user_toolbar"
            layout="@layout/common_toolbar_text"
            app:titleText="@{titleText}" />

        <LinearLayout
            android:id="@+id/add_user_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:orientation="vertical"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:layout_gravity="start"
                android:gravity="center"
                android:text="초대 코드를 입력해주세요"
                android:fontFamily="@font/nanum_bold"
                android:textColor="@color/main_white"
                android:textSize="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="5dp"
                android:layout_gravity="start"
                android:gravity="center"
                android:text="관리자한테 초대코드를 받아주세요"
                android:fontFamily="@font/nanum_bold"
                android:textColor="@color/main_white"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/login_input_email"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/input_round_white"
                android:fontFamily="@font/nanum_bold"
                android:hint=" "
                android:autofillHints=""
                android:inputType="text"
                android:padding="15dp"
                android:textColorHint="@color/main_black"
                android:textSize="18sp" />



            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/guest_request_BTN"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_round_black"
                android:fontFamily="@font/nanum_bold"
                android:text="승인요청"
                android:textColor="@color/main_white"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginVertical="10dp"
                android:background="#80FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="10dp"
                android:layout_gravity="start"
                android:gravity="center"
                android:text="승인대기 중인 그룹"
                android:fontFamily="@font/nanum_bold"
                android:textColor="@color/main_white"
                android:textSize="20sp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/guest_request_group_RV"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="15dp"
            app:layout_constraintTop_toBottomOf="@+id/add_user_container"
            app:layout_constraintBottom_toTopOf="@+id/guest_request_group_BTN"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_gravity="center"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/guest_request_group_BTN"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="30dp"
            android:layout_marginBottom="50dp"
            android:background="@drawable/btn_round_black"
            android:fontFamily="@font/nanum_bold"
            android:text="내 그룹 만들기"
            android:textColor="@color/main_white"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>

