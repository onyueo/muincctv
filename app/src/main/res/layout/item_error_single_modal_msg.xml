<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/modal_round_white"
        android:orientation="vertical"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:paddingHorizontal="50dp"
        android:paddingVertical="30dp">

        <!--  상단  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/single_alam_modal_img"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp"
                android:visibility="visible"
                android:src="@drawable/modal_warning_icon"/>

            <TextView
                android:id="@+id/single_alam_modal_title"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="25dp"
                android:text="Error"
                android:textColor="@color/main_red"
                android:textSize="24sp"
                android:visibility="visible"
                android:fontFamily="@font/nanum_bold" />

            <TextView
                android:id="@+id/single_alam_modal_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                android:layout_gravity="center"
                android:textAlignment="center"
                android:text="에러 메시지"
                android:textColor="@color/main_black"
                android:textSize="20sp"
                android:visibility="visible"
                android:fontFamily="@font/nanum_reguler" />

        </LinearLayout>


        <!--  하단  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/single_alam_modal_BTN"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_round_black"
                android:fontFamily="@font/nanum_bold"
                android:text="확인"
                android:textColor="@color/main_white"
                android:textSize="18sp" />

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>